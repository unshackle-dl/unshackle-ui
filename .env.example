# --- Browser defaults (build-time, inlined by Vite) ---
# Default unshackle API base URL + secret key. These are only defaults — the
# Settings page overrides them at runtime (stored in the browser). Leave the key
# blank for deployments running with --no-key.
PUBLIC_UNSHACKLE_API_URL=http://localhost:8786
PUBLIC_UNSHACKLE_API_KEY=

# --- Server (runtime, read from process.env by the Node process) ---
# The tracking store and poller run server-side and cannot see the browser's Settings
# page, so they need their own copy. These are read at boot rather than baked into the
# build, so a built image can be pointed elsewhere without rebuilding. They can
# legitimately disagree with what a given browser is using. Leaving UNSHACKLE_API_URL
# blank keeps the poller inert rather than letting it hammer the default forever.
UNSHACKLE_API_URL=http://localhost:8786
UNSHACKLE_API_KEY=

# sqlite file for tracked titles. Must be writable and must survive restarts.
TRACKING_DB_PATH=./data/tracking.db

# How often every tracked title is swept (default 6h), and the gap between individual
# checks inside a sweep (default 30s). list-titles does a full auth + CDM load per call
# on the unshackle side, so checks are staggered rather than fanned out.
TRACKING_INTERVAL_MS=21600000
TRACKING_STAGGER_MS=30000

# Optional outbound webhook (Discord, ntfy, anything that accepts a JSON POST).
# One summary POST per check cycle, not one per episode. Blank disables it.
TRACKING_WEBHOOK_URL=
